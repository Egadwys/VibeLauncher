<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/home_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <!-- Search bar atas (disembunyikan saat dock dua baris aktif) -->
        <TextView
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="12dp"
            android:background="@drawable/bg_search"
            android:clickable="true"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="12dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/search"
            android:textColor="#B3FFFFFF"
            android:textSize="16sp" />

        <com.ega.project.vibelauncher.HomeGridLayout
            android:id="@+id/home_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <View
            android:id="@+id/dock_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#4033B5E5" />

        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dock"
            android:orientation="vertical">

            <!-- Baris 1: 2 app, tombol semua aplikasi (tengah), 2 app -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/dock_slot_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:padding="14dp" />

                <ImageView
                    android:id="@+id/dock_slot_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:padding="14dp" />

                <ImageView
                    android:id="@+id/btn_apps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:contentDescription="@string/apps"
                    android:padding="20dp"
                    android:src="@drawable/ic_apps" />

                <ImageView
                    android:id="@+id/dock_slot_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:padding="14dp" />

                <ImageView
                    android:id="@+id/dock_slot_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:padding="14dp" />
            </LinearLayout>

            <!-- Baris 2 (opsional): search bar bawaan atau widget Google Search -->
            <FrameLayout
                android:id="@+id/dock_search_row"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/search_bar_dock"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_search"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/search"
                    android:textColor="#B3FFFFFF"
                    android:textSize="16sp" />

                <FrameLayout
                    android:id="@+id/dock_widget_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bar target drag: Hapus / Info aplikasi / Copot (muncul saat drag) -->
    <FrameLayout
        android:id="@+id/drag_bar_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/drag_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#E6101010"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/drag_remove"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/drag_remove"
                android:textColor="@color/holo_blue"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/drag_info"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/app_info"
                android:textColor="@color/holo_blue"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/drag_uninstall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/uninstall"
                android:textColor="@color/holo_blue"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- App drawer: halaman digeser ke samping seperti Jelly Bean -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EE000000"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/drawer_title"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingEnd="16dp"
                    android:text="@string/apps"
                    android:textAllCaps="true"
                    android:textColor="@color/holo_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/drawer_underline"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@color/holo_blue" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/drawer_overflow"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_item"
                android:gravity="center"
                android:text="&#8942;"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </LinearLayout>

        <View
            android:id="@+id/drawer_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/holo_line" />

        <EditText
            android:id="@+id/drawer_search"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_search"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="12dp"
            android:hint="@string/search_apps"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#80FFFFFF"
            android:textSize="16sp" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/drawer_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/drawer_dots"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
