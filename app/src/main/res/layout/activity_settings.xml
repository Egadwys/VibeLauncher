<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/grid_settings"
            android:textAllCaps="true"
            android:textColor="@color/holo_blue"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:background="@color/holo_blue" />

        <TextView
            android:id="@+id/label_home_cols"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_home_cols"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:stepSize="1"
            android:valueFrom="3"
            android:valueTo="6" />

        <TextView
            android:id="@+id/label_home_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_home_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:stepSize="1"
            android:valueFrom="3"
            android:valueTo="7" />

        <TextView
            android:id="@+id/label_drawer_cols"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_drawer_cols"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:stepSize="1"
            android:valueFrom="3"
            android:valueTo="7" />

    </LinearLayout>
</ScrollView>
